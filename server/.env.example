# Stripe (get keys from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...

# For marking invoices paid automatically when customer completes checkout.
# Create a webhook in Stripe Dashboard: https://dashboard.stripe.com/webhooks
# Endpoint URL: https://your-domain.com/api/stripe-webhook (or use Stripe CLI for local testing)
# Event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: default 3001 (set by Render/Railway automatically)
PORT=3001

# On Railway: set to your volume mount path (e.g. /data) so SQLite and payments persist
# DATA_DIR=/data

# If you deploy frontend and backend separately, set this to the frontend URL for CORS
# FRONTEND_ORIGIN=https://app.aurorasonnet.com

# Admin login (see scripts/hash-password.cjs to generate ADMIN_PASSWORD_HASH)
# ADMIN_USERNAME=youradmin
# ADMIN_PASSWORD_HASH=$2b$12$...
# SESSION_SECRET=long-random-string

# "Forgot username or password" recovery emails are sent here (defaults to REMINDER_EMAIL_TO,
# then SMTP_USER, if unset). Requires SMTP_HOST/PORT/USER/PASS to be configured to send.
# ADMIN_RECOVERY_EMAIL=you@example.com

# Public URL used to build the password-reset link in that email.
# Defaults to RENDER_EXTERNAL_URL, then https://aurora-sonnet-1.onrender.com.
# APP_URL=https://aurora-sonnet-1.onrender.com
